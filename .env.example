# Copy to .env (never committed) and adjust.
# Keys use ASP.NET Core's double-underscore convention: Site__Title maps to Site:Title.
# Wrap a value in single quotes if it contains $, # or spaces.

# Host port for http://localhost:<port> (read by docker compose itself)
HTTP_PORT=8080

# Site identity
Site__Title=Blog
Site__Tagline=Notes et articles
Site__PortfolioUrl=https://example.com

# Admin account (sign in at /admin). Required on first start, to create the account.
# On later starts, values that are set replace the stored ones: change the password here and
# restart to reset it (this also lifts a lockout). At least 12 characters.
Admin__Email=admin@example.com
Admin__Password=
