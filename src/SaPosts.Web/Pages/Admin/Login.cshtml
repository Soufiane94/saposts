@page
@model LoginModel
@{
    ViewData["Title"] = "Connexion";
}
<div class="admin-frame">
    <h1 class="admin-title">Connexion</h1>

    @if (Model.ErrorMessage is not null)
    {
        <p class="form-alert" role="alert">@Model.ErrorMessage</p>
    }

    <form method="post" class="form" asp-route-returnUrl="@Model.ReturnUrl">
        <div class="field">
            <label asp-for="Input.Email"></label>
            <input asp-for="Input.Email" autocomplete="username" required />
            <span asp-validation-for="Input.Email" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="Input.Password"></label>
            <input asp-for="Input.Password" autocomplete="current-password" required />
            <span asp-validation-for="Input.Password" class="field-error"></span>
        </div>
        <div>
            <button type="submit" class="button">Se connecter</button>
        </div>
    </form>
</div>
